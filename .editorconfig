# Vesion: 1.0 2026-10-21

root = true

# Common settings
[*]
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space

# Windows batch scripts
[*.{bat,cmd}]
end_of_line = crlf

[*.cs]

# File organization, namespaces, and using directives
csharp_style_namespace_declarations = file_scoped
# IDE0161: Require file-scoped namespaces.
dotnet_diagnostic.IDE0161.severity = warning

# IDE0130: Do not require namespaces to match the folder structure.
dotnet_diagnostic.IDE0130.severity = none

csharp_style_prefer_top_level_statements = true
csharp_using_directive_placement = outside_namespace

# RCS1060: Declare each top-level type in a separate file.
dotnet_diagnostic.RCS1060.severity = warning

# Private field naming
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

# Accessibility, fields, and structs
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_style_readonly_field = true
csharp_style_prefer_readonly_struct = true
csharp_style_prefer_readonly_struct_member = true

# Variable declarations and type inference
csharp_style_var_elsewhere = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
# RCS1118: Do not require local variables to be marked const.
dotnet_diagnostic.RCS1118.severity = none

# Constructors, properties, and records
dotnet_style_prefer_auto_properties = true
csharp_style_prefer_primary_constructors = false
csharp_style_prefer_simple_property_accessors = true
# RCS1194: Do not require standard exception constructors.
dotnet_diagnostic.RCS1194.severity = none
# RCS1251: Do not require removing unnecessary braces from record declarations.
dotnet_diagnostic.RCS1251.severity = none

# Local functions, lambdas, and delegates
csharp_style_conditional_delegate_call = true
csharp_prefer_static_anonymous_function = false
csharp_prefer_static_local_function = true
csharp_style_prefer_method_group_conversion = false
csharp_style_prefer_local_over_anonymous_function = true

# Collections, initializers, and ranges
dotnet_style_prefer_collection_expression = when_types_loosely_match
# IDE0305: Do not suggest collection expressions for fluent collection initialization.
dotnet_diagnostic.IDE0305.severity = none

csharp_style_prefer_index_operator = true
csharp_style_prefer_range_operator = true

# Tuples and anonymous types
dotnet_style_explicit_tuple_names = true
csharp_style_prefer_tuple_swap = true

# Null checks, casts, and pattern matching
dotnet_style_prefer_foreach_explicit_cast_in_source = when_strongly_typed
dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_style_prefer_non_hidden_explicit_cast_in_source = true
csharp_style_prefer_null_check_over_type_check = true

# Expressions and control flow
dotnet_style_prefer_compound_assignment = true
dotnet_style_prefer_simplified_boolean_expressions = true
csharp_style_prefer_labeled_jump_statements = true

# Strings, nameof, and hash codes
dotnet_prefer_system_hash_code = true
dotnet_style_prefer_simplified_interpolation = true
csharp_style_prefer_unbound_generic_type_in_nameof = true
csharp_style_prefer_utf8_string_literals = true

# Resources and synchronization
csharp_prefer_simple_using_statement = true
csharp_prefer_system_threading_lock = true

# Unused parameters
dotnet_code_quality_unused_parameters = all

# Braces and blocks
csharp_prefer_braces = true
# IDE0011: Require braces for control-flow statements.
dotnet_diagnostic.IDE0011.severity = warning

csharp_new_line_before_open_brace = all
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# RCS0042: Put auto-accessors on a single line.
dotnet_diagnostic.RCS0042.severity = warning

# RCS0021: Allow single-line blocks only when empty.
dotnet_diagnostic.RCS0021.severity = warning
roslynator_block_braces_style = single_line_when_empty

# Line breaks and blank lines
dotnet_style_operator_placement_when_wrapping = end_of_line
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true
# RCS0008: Add a blank line between a closing brace and the next statement.
dotnet_diagnostic.RCS0008.severity = warning
# RCS0016: Put attribute lists on their own lines.
dotnet_diagnostic.rcs0016.severity = warning
# RCS0010: Add a blank line between declarations, except pairs of single-line declarations.
dotnet_diagnostic.rcs0010.severity = warning

# Indentation
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current
csharp_indent_switch_labels = true

# Spacing
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false
